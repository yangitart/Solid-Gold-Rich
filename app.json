{
  "expo": {
    "name": "Solid Gold Rich",
    "slug": "solid-gold-rich",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/images/iconapp.png",
    "scheme": "imrich",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/iconapp-transparent.png",
        "backgroundColor": "#04050A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.escobar.solidgold",
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "barStyle": "light-content"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/iconapp-transparent.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#04050A"
        }
      ],
      "expo-localization",
      "./plugins/withAndroidReleaseOptimization"
    ],
    "extra": {
      "eas": {
        "projectId": "6c97965e-d56f-420e-b83c-ecea6cf66ed7"
      }
    },
    "owner": "yangitart"
  }
}
